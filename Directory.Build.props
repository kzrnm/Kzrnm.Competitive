<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="CompetitiveAnalyzer_UseMethodImplNumeric" />
  </ItemGroup>
  <PropertyGroup>
    <SourceExpanderVersion>9.1.2</SourceExpanderVersion>
    <CompetitiveAnalyzer_UseMethodImplNumeric>True</CompetitiveAnalyzer_UseMethodImplNumeric>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DisableCheckSourceExpanderVersion>true</DisableCheckSourceExpanderVersion>

    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
  </PropertyGroup>
</Project>
